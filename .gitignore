# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
data/
.env

# Additional data
.DS_store
*.ipynb
*.pdf
*.xlsx
scripts/
wandb/
checkpoints/
evaluations/
pretrained/

# Keep personal configs local, but track the worked examples that document the
# schema. This must be "configs/*" and not "configs/": git cannot re-include a file
# once its parent directory itself is excluded.
configs/*
!configs/example.json
!configs/example_sweep.yaml
!configs/README.md
# The benchmark configs ARE the audit trail for the architecture comparison: they
# record the exact protocol every arm was evaluated under. checkpoints/ is gitignored
# too, so without these the only surviving record is metadata.pth inside runs.
!configs/bench_*.json
!configs/bench_*_sweep.yaml

condor/*
!condor/README.md
!condor/sync_to_hpc.sh

reports/