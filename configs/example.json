{
  "epochs": 50,
  "device": "auto",
  "wandb_entity": null,
  "wandb_project": "alzheimer-detection",
  "wandb_mode": "online",
  "wandb_name": null,
  "dataset": {
    "name": "oasis",
    "image_glob": "data/T88_111_masked/*masked_gfc.img",
    "label_path": "data/oasis_cross-sectional_cdr_cleaned.xlsx"
  },
  "model": {
    "name": "Simple3DCNN",
    "params": {
      "num_classes": 2,
      "in_channels": 1,
      "channels": [
        16,
        32,
        64
      ],
      "kernel_size": 3,
      "padding": 1,
      "pool_kernel_size": 2,
      "use_batch_norm": true,
      "dropout": 0.0
    }
  },
  "loss": {
    "name": "CrossEntropyLoss",
    "params": {}
  },
  "optimizer": {
    "name": "AdamW",
    "params": {
      "lr": 0.0001,
      "weight_decay": 0.01
    }
  },
  "transforms": {
    "resize": true,
    "spatial_size": [
      96,
      128,
      96
    ],
    "resize_mode": "trilinear",
    "scale_intensity": false,
    "normalize_intensity": true,
    "normalize_nonzero": true,
    "normalize_channel_wise": true,
    "rand_rotate90": false,
    "rand_rotate90_prob": 0.5,
    "rand_rotate90_spatial_axes": [
      0,
      2
    ]
  },
  "split": {
    "train_size": 0.7,
    "val_size": 0.15,
    "test_size": 0.15,
    "random_seed": 42
  },
  "cv": {
    "enabled": false,
    "n_splits": 5,
    "shuffle": true,
    "random_seed": 42
  },
  "dataloader": {
    "batch_size": 2,
    "num_workers": 0
  },
  "checkpoint": {
    "dir": "checkpoints",
    "save_last": true,
    "save_best": true,
    "best_filename": "best_epoch_{epoch:03d}.pth",
    "last_filename": "last.pth",
    "monitor": "val_auc",
    "mode": "max",
    "min_delta": 0.01
  },
  "early_stopping": {
    "enabled": true,
    "patience": 10
  },
  "threshold": {
    "cv_strategy": "vertical_average",
    "fpr_rounding": "at_least",
    "fpr_grid": 101,
    "threshold_grid": 0
  },
  "evaluation": {
    "output_dir": "evaluations",
    "log_wandb": false,
    "save_predictions": true
  }
}
