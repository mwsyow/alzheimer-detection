{
  "epochs": 60,
  "device": "auto",
  "wandb_entity": null,
  "wandb_project": "alzheimer-detection",
  "wandb_mode": "online",
  "wandb_name": "bench-efficientnet-b0",
  "dataset": {
    "name": "oasis",
    "image_glob": "data/T88_111_masked/*masked_gfc.img",
    "label_path": "data/oasis_cross-sectional_cdr_cleaned.xlsx"
  },
  "model": {
    "name": "EfficientNetBN",
    "params": {
      "num_classes": 2,
      "in_channels": 1,
      "spatial_dims": 3,
      "model_name": "efficientnet-b0",
      "norm": [
        "batch",
        {
          "momentum": 0.1,
          "eps": 0.001
        }
      ]
    },
    "pretrained": {
      "enabled": false
    }
  },
  "loss": {
    "name": "CrossEntropyLoss",
    "params": {
      "label_smoothing": 0.1
    }
  },
  "optimizer": {
    "name": "AdamW",
    "params": {
      "lr": 0.0001,
      "weight_decay": 0.1
    }
  },
  "transforms": {
    "resize": true,
    "spatial_size": [
      96,
      128,
      96
    ],
    "resize_mode": "trilinear",
    "scale_intensity": false,
    "normalize_intensity": true,
    "normalize_nonzero": true,
    "normalize_channel_wise": true,
    "rand_rotate90": false,
    "rand_flip": false,
    "rand_affine": false,
    "rand_bias_field": false,
    "rand_gaussian_noise": false,
    "rand_scale_intensity": false,
    "rand_shift_intensity": false
  },
  "split": {
    "train_size": 0.7,
    "val_size": 0.15,
    "test_size": 0.15,
    "random_seed": 42
  },
  "cv": {
    "enabled": true,
    "n_splits": 5,
    "shuffle": true,
    "random_seed": 42
  },
  "dataloader": {
    "batch_size": 8,
    "num_workers": 4
  },
  "checkpoint": {
    "dir": "checkpoints",
    "save_last": true,
    "save_best": true,
    "best_filename": "best_epoch_{epoch:03d}.pth",
    "last_filename": "last.pth",
    "monitor": "val_auc",
    "mode": "max",
    "min_delta": 0.0
  },
  "early_stopping": {
    "enabled": false,
    "patience": 10
  },
  "threshold": {
    "cv_strategy": "vertical_average",
    "fpr_rounding": "at_least",
    "fpr_grid": 101,
    "threshold_grid": 0
  },
  "evaluation": {
    "output_dir": "evaluations",
    "log_wandb": false,
    "save_predictions": true
  }
}
